# Variables for running OpenTofu against LocalStack locally.
# Copy to .env (git-ignored), fill in the placeholders, then load it into your
# shell before running tofu:  set -a; . ./.env; set +a

# LocalStack accepts any credentials; "test" is the convention.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Passphrase for client-side state and plan encryption (at least 16 characters).
# Losing it means losing access to the encrypted state.
TF_VAR_state_passphrase=<at least 16 characters>

# Required by the localstack/localstack-pro image.
LOCALSTACK_AUTH_TOKEN=<your token>
